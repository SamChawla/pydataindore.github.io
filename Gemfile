# GitHub Pages builds the site for you, but this Gemfile lets you
# preview it locally with the SAME versions GitHub uses.
#
#   gem install bundler        # one time
#   bundle install             # one time (and after editing this file)
#   bundle exec jekyll serve    # preview at http://localhost:4000
#
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick" # required for `jekyll serve` on Ruby 3.x
